# Backend environment configuration
# Copy this file to .env and adjust the values for your local setup.
# Never commit the real .env file — it contains credentials.

# Server
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solicitudapp
DB_USER=postgres
DB_PASSWORD=your_password_here

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# File uploads
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=5242880

# Set to "production" to enable secure cookies
NODE_ENV=development
